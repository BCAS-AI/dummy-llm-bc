{
  "info": {
    "_postman_id": "5f2a9b1c-7e3d-4b6a-9c2e-1a8d4f6b0c3e",
    "name": "dummy-abc-llm",
    "description": "Static-response simulator mirroring the ABC OpenAPI OAuth & Signature and LLM Gateway Multimodal API contracts. No real LLM is called.\n\nRun \"Get Access Token\" first (it stores the token in a collection variable), then run anything under \"Core Resources\". Signatures are generated automatically:\n- RSA (asymmetric) via the /dev/sign/oauth helper route (Postman's sandbox has no RSA-signing primitive)\n- HMAC-SHA512 (symmetric) natively in the pre-request script via CryptoJS\n\nSet the `baseUrl` collection variable to point at localhost or a deployed instance (e.g. Vercel).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "clientId",
      "value": "b66925de-d8ec-476e-a170-6cf06c863b78",
      "type": "string"
    },
    {
      "key": "clientSecret",
      "value": "efc71ced-b0e7-4b47-8270-3c24829764aa",
      "type": "string"
    },
    {
      "key": "channelId",
      "value": "95424",
      "type": "string"
    },
    {
      "key": "partnerId",
      "value": "DIGITAL230844211",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "oauthTimestamp",
      "value": "",
      "type": "string"
    },
    {
      "key": "oauthSignature",
      "value": "",
      "type": "string"
    },
    {
      "key": "llmTimestamp",
      "value": "",
      "type": "string"
    },
    {
      "key": "llmSignature",
      "value": "",
      "type": "string"
    },
    {
      "key": "externalId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authorization",
      "item": [
        {
          "name": "Get Access Token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// RSA signing isn't available in Postman's sandbox, so this calls the",
                  "// simulator's own /dev/sign/oauth helper route to get a freshly signed",
                  "// X-TIMESTAMP / X-SIGNATURE pair for the seeded test client.",
                  "const helperUrl = pm.collectionVariables.get('baseUrl') + '/dev/sign/oauth';",
                  "",
                  "pm.sendRequest({ url: helperUrl, method: 'GET' }, function (err, res) {",
                  "    if (err) {",
                  "        console.error('dummy-abc-llm: failed to reach /dev/sign/oauth', err);",
                  "        return;",
                  "    }",
                  "    const body = res.json();",
                  "    pm.collectionVariables.set('oauthTimestamp', body.timestamp);",
                  "    pm.collectionVariables.set('oauthSignature', body.signature);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('responseCode is 2007300', function () {",
                  "    pm.expect(json.responseCode).to.eql('2007300');",
                  "});",
                  "",
                  "if (json.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "    console.log('dummy-abc-llm: saved accessToken for the Core Resources requests.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-TIMESTAMP",
                "value": "{{oauthTimestamp}}"
              },
              {
                "key": "X-CLIENT-KEY",
                "value": "{{clientId}}"
              },
              {
                "key": "X-SIGNATURE",
                "value": "{{oauthSignature}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grantType\": \"client_credentials\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/openapi/v1.0/access-token/b2b",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "openapi",
                "v1.0",
                "access-token",
                "b2b"
              ]
            },
            "description": "OAuth2 client_credentials grant. Run this first — it stores the returned accessToken in a collection variable for the requests under \"Core Resources\"."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Core Resources",
      "item": [
        {
          "name": "LLM Gateway Multimodal",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Symmetric (HMAC-SHA512) signing, done natively via CryptoJS — no",
                  "// helper route needed for this one.",
                  "const timestamp = new Date().toISOString().split('.')[0] + 'Z';",
                  "const relativeUrl = '/openapi/v1.0/llm-gateway/multimodal';",
                  "const accessToken = pm.collectionVariables.get('accessToken');",
                  "const clientSecret = pm.collectionVariables.get('clientSecret');",
                  "",
                  "if (!accessToken) {",
                  "    console.warn('dummy-abc-llm: accessToken is empty — run \"Get Access Token\" first.');",
                  "}",
                  "",
                  "// Body must contain literal values, not {{variables}}: this script reads",
                  "// pm.request.body.raw, which is the UNRESOLVED template text — signing",
                  "// that instead of the final sent bytes would produce a mismatched",
                  "// signature if the body used {{...}} placeholders.",
                  "const bodyRaw = pm.request.body ? pm.request.body.raw : '';",
                  "let minified = '';",
                  "if (bodyRaw && bodyRaw.trim().length > 0) {",
                  "    minified = JSON.stringify(JSON.parse(bodyRaw));",
                  "}",
                  "",
                  "const bodyHashHex = CryptoJS.SHA256(minified).toString(CryptoJS.enc.Hex).toLowerCase();",
                  "const stringToSign = 'POST:' + relativeUrl + ':' + accessToken + ':' + bodyHashHex + ':' + timestamp;",
                  "const signature = CryptoJS.HmacSHA512(stringToSign, clientSecret).toString(CryptoJS.enc.Base64);",
                  "",
                  "pm.collectionVariables.set('llmTimestamp', timestamp);",
                  "pm.collectionVariables.set('llmSignature', signature);",
                  "pm.collectionVariables.set('externalId', String(Date.now()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('responseCode is 200LM00', function () {",
                  "    pm.expect(json.responseCode).to.eql('200LM00');",
                  "});",
                  "",
                  "pm.test('result.answer is present', function () {",
                  "    pm.expect(json.result && json.result.answer).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-TIMESTAMP",
                "value": "{{llmTimestamp}}"
              },
              {
                "key": "X-SIGNATURE",
                "value": "{{llmSignature}}"
              },
              {
                "key": "CHANNEL-ID",
                "value": "{{channelId}}"
              },
              {
                "key": "X-PARTNER-ID",
                "value": "{{partnerId}}"
              },
              {
                "key": "X-EXTERNAL-ID",
                "value": "{{externalId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"b66925de-d8ec-476e-a170-6cf06c863b78\",\n  \"sessionId\": \"session001\",\n  \"requestId\": \"request001\",\n  \"configs\": {\n    \"task\": \"vllm-text-generation\",\n    \"recommendation\": true\n  },\n  \"prompt\": \"buatkanlah cerita dongeng terbentuknya sebuah wilayah\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/openapi/v1.0/llm-gateway/multimodal",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "openapi",
                "v1.0",
                "llm-gateway",
                "multimodal"
              ]
            },
            "description": "Requires accessToken to be set (run \"Get Access Token\" first). Body values are literal (not {{variables}}) — see the pre-request script comment for why."
          },
          "response": []
        },
        {
          "name": "LLM Gateway Multimodal - Simulate Error (403LM00)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const timestamp = new Date().toISOString().split('.')[0] + 'Z';",
                  "const relativeUrl = '/openapi/v1.0/llm-gateway/multimodal';",
                  "const accessToken = pm.collectionVariables.get('accessToken');",
                  "const clientSecret = pm.collectionVariables.get('clientSecret');",
                  "",
                  "const bodyRaw = pm.request.body ? pm.request.body.raw : '';",
                  "let minified = '';",
                  "if (bodyRaw && bodyRaw.trim().length > 0) {",
                  "    minified = JSON.stringify(JSON.parse(bodyRaw));",
                  "}",
                  "",
                  "const bodyHashHex = CryptoJS.SHA256(minified).toString(CryptoJS.enc.Hex).toLowerCase();",
                  "const stringToSign = 'POST:' + relativeUrl + ':' + accessToken + ':' + bodyHashHex + ':' + timestamp;",
                  "const signature = CryptoJS.HmacSHA512(stringToSign, clientSecret).toString(CryptoJS.enc.Base64);",
                  "",
                  "pm.collectionVariables.set('llmTimestamp', timestamp);",
                  "pm.collectionVariables.set('llmSignature', signature);",
                  "pm.collectionVariables.set('externalId', String(Date.now()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "console.log('dummy-abc-llm: simulated error ->', json.responseCode, json.responseMessage);",
                  "",
                  "pm.test('Returns the simulated error code', function () {",
                  "    pm.expect(json.responseCode).to.eql('403LM00');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-TIMESTAMP",
                "value": "{{llmTimestamp}}"
              },
              {
                "key": "X-SIGNATURE",
                "value": "{{llmSignature}}"
              },
              {
                "key": "CHANNEL-ID",
                "value": "{{channelId}}"
              },
              {
                "key": "X-PARTNER-ID",
                "value": "{{partnerId}}"
              },
              {
                "key": "X-EXTERNAL-ID",
                "value": "{{externalId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"b66925de-d8ec-476e-a170-6cf06c863b78\",\n  \"prompt\": \"SIMULATE_ERROR:403LM00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/openapi/v1.0/llm-gateway/multimodal",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "openapi",
                "v1.0",
                "llm-gateway",
                "multimodal"
              ]
            },
            "description": "Demonstrates the simulator-only SIMULATE_ERROR:<code> trigger (still requires a valid signature/token). Swap the code in the body to exercise any other documented error — see GET /docs."
          },
          "response": []
        }
      ]
